generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One participant's application for one event. The unique pair is the rule:
/// applying twice is the same place, not a second row.
model Applications {
  id                String            @id @default(cuid())
  eventId           String
  applier           String
  /// What the organiser reads first: why this person belongs on a team.
  additionalMessage String
  companyName       String?
  companyEmail      String?
  applicationDate   DateTime          @default(now())
  lastUpdated       DateTime          @default(now())
  status            ApplicationStatus @default(IN_PROGRESS)
  /// Why an admin turned the application down; null until rejected with a note.
  reasonForRejection String?
  user              User              @relation(fields: [applier], references: [id], onDelete: Cascade)
  event             HackathonEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, applier])
  @@index([eventId, applicationDate])
  @@index([applier])
}

model User {
  id                  String         @id
  name                String
  email               String         @unique
  emailVerified       Boolean        @default(false)
  image               String?
  role                String         @default("participant")
  banned              Boolean        @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sessions            Session[]
  accounts            Account[]
  applications        Applications[]
  createdEvents       HackathonEvent[]
  notifications       Notification[]
}

model Session {
  id             String   @id
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum ApplicationStatus {
  IN_PROGRESS
  ACCEPTED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum SponsorTier {
  MAIN
  CO_SPONSOR
}

/// One account's message to another: who sent it (null for the system), to
/// whom, the rendered text and a payload the console can act on, the unread
/// state, and the timestamp it first arrived in the consumer's inbox.
model Notification {
  id         String    @id @default(cuid())
  senderId   String?
  receiverId String
  /// The payload: `kind` for what the console does with it, plus the row's
  /// address (`id` of the application, event, and so on). Modeled as JSON so
  /// new kinds do not change the table.
  data       Json
  message    String
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User?     @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, read, createdAt])
  @@index([receiverId, id])
}

/// An event the portal hosts. Only PUBLISHED events are listed publicly; the
/// rest are visible to admins while they are being prepared.
model HackathonEvent {
  id                   String        @id @default(cuid())
  title                String
  description          String
  startsAt             DateTime
  endsAt               DateTime
  registrationDeadline DateTime?
  /// Null means the event is online and has no venue.
  location             String?
  /// Public URLs of the event's images, `/bucket/event_images/<file>` for the
  /// ones uploaded through the API. Order is the order they were attached.
  imageUrls            String[]      @default([])
  /// The one wide image behind the event's header, `/bucket/event_images/<file>`
  /// for one uploaded through the API. Null means the header stays plain.
  backgroundUrl        String?
  status               EventStatus   @default(DRAFT)
  /// Null once the organising account is deleted; the event outlives it.
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sponsors             Sponsor[]
  applications         Applications[]

  @@index([status, startsAt])
  @@index([createdById])
}

/// A company that can sponsor events. One row, reused across every event it
/// backs, so its logo and site are entered once.
model Company {
  id        String    @id @default(cuid())
  name      String    @unique
  website   String?
  logoUrl   String?
  industry  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sponsors  Sponsor[]
}

/// The sponsorship itself: which company backs which event, and at what tier.
/// A company appears at most once per event, so promoting it from co-sponsor
/// to main sponsor is an update rather than a second row.
model Sponsor {
  id           String        @id @default(cuid())
  eventId      String
  companyId    String
  tier         SponsorTier   @default(CO_SPONSOR)
  /// Free text for what they put in, for example "Cloud credits" or "$5,000".
  contribution String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  event        HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([eventId, companyId])
  @@index([companyId])
}
