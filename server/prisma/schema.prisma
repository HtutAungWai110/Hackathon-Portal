generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Applications {
  id              String            @id
  companyName     String
  companyEmail    String
  applier         String
  applicationDate DateTime          @default(now())
  lastUpdated     DateTime          @default(now())
  status          ApplicationStatus @default(IN_PROGRESS)
  position        String
  User            User              @relation(fields: [applier], references: [id], onDelete: Cascade)
}

model User {
  id                  String         @id
  name                String
  email               String         @unique
  emailVerified       Boolean        @default(false)
  image               String?
  role                String         @default("participant")
  banned              Boolean        @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sessions            Session[]
  accounts            Account[]
  Applications        Applications[]
  createdEvents       HackathonEvent[]
  eventRegistrations  EventRegistration[]
}

model Session {
  id             String   @id
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum ApplicationStatus {
  IN_PROGRESS
  INTERVIEW
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum SponsorTier {
  MAIN
  CO_SPONSOR
}

/// An event the portal hosts. Only PUBLISHED events are listed publicly; the
/// rest are visible to admins while they are being prepared.
model HackathonEvent {
  id                   String        @id @default(cuid())
  title                String
  description          String
  startsAt             DateTime
  endsAt               DateTime
  registrationDeadline DateTime?
  /// Null means the event is online and has no venue.
  location             String?
  /// Public URLs of the event's images, `/bucket/event_images/<file>` for the
  /// ones uploaded through the API. Order is the order they were attached.
  imageUrls            String[]      @default([])
  /// The one wide image behind the event's header, `/bucket/event_images/<file>`
  /// for one uploaded through the API. Null means the header stays plain.
  backgroundUrl        String?
  status               EventStatus   @default(DRAFT)
  /// Null once the organising account is deleted; the event outlives it.
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdBy            User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sponsors             Sponsor[]
  registrations        EventRegistration[]

  @@index([status, startsAt])
  @@index([createdById])
}

/// One participant holding a place at one event. The unique pair is the rule:
/// clicking Register twice is the same registration, not a second row.
model EventRegistration {
  id        String         @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime       @default(now())
  event     HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, createdAt])
  @@index([userId])
}

/// A company that can sponsor events. One row, reused across every event it
/// backs, so its logo and site are entered once.
model Company {
  id        String    @id @default(cuid())
  name      String    @unique
  website   String?
  logoUrl   String?
  industry  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sponsors  Sponsor[]
}

/// The sponsorship itself: which company backs which event, and at what tier.
/// A company appears at most once per event, so promoting it from co-sponsor
/// to main sponsor is an update rather than a second row.
model Sponsor {
  id           String        @id @default(cuid())
  eventId      String
  companyId    String
  tier         SponsorTier   @default(CO_SPONSOR)
  /// Free text for what they put in, for example "Cloud credits" or "$5,000".
  contribution String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  event        HackathonEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([eventId, companyId])
  @@index([companyId])
}
