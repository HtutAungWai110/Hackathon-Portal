ARCJET_ENV=development
ARCJET_KEY=ajkey_your_site_key_here
ARCJET_MODE=DRY_RUN

# PostgreSQL connection for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hackathon?schema=public"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_secret_of_at_least_32_characters
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth 2.0
# Authorized redirect URI must be: http://localhost:3000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail. ADMIN_EMAIL is the SMTP user, the From address, and the address the
# seed script promotes to administrator. APP_PASSWORD is a Google app password
# (not the account password). Leave both empty to log verification and reset
# links instead of sending them; the queue still runs, the log is the sink.
ADMIN_EMAIL=
APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
MAIL_FROM_NAME=Hackathon Portal

# Redis backs the BullMQ mail queue. Start it with: docker compose up -d redis
REDIS_URL=redis://localhost:6379

# Browser origin allowed to call this API, comma separated.
# Not set: defaults to http://localhost:5173 and http://localhost:5137
CLIENT_URL=http://localhost:5173,http://localhost:5137

# JWT signing secrets, one per token type, at least 32 characters.
# Generate each with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace_with_a_secret_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_secret_of_at_least_32_characters
